<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.night-shift" path="/org/gnome/shell/extensions/night-shift/">
    <key name="show-indicator" type="b">
      <default>true</default>
    </key>
    <key name="use-geoclue" type="b">
      <description>Use Geoclue to determine location</description>
      <default>true</default>
    </key>
    <key name="times" type="s">
      <default>"sunrise,sunset"</default>
      <summary>Exactaly two times represented as strings</summary>
    </key>
    <key name="day-or-night" type="s">
      <summary>day or night</summary>
      <default>"day"</default>
    </key>
    <key name="determined-coordinates" type="s">
      <summary>determine coorinates at runtime</summary>
      <description>Determined coordinates of user from current run</description>
      <default>""</default>
    </key>
    <key name="last-known-coordinates" type="s">
      <summary>Last known coordinates</summary>
      <description>Last coordinates saved in cache</description>
      <default>""</default>
    </key>
    <key name="static-longitude" type="s">
      <summary>User-defined longitude</summary>
      <default>""</default>
    </key>
    <key name="static-latitude" type="s">
      <summary>User-defined latitude</summary>
      <default>""</default>
    </key>
    <key name="tzid" type="s">
      <summary>timezone id</summary>
      <default>""</default>
    </key>
    <key name="timestamp" type="s">
      <description>timestamp of last run</description>
      <default>""</default>
    </key>
  </schema>
</schemalist>
