<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.night-shift" path="/org/gnome/shell/extensions/night-shift/">
    <key name="show-indicator" type="b">
      <default>true</default>
    </key>
    <key name="times" type="s">
      <default>"sunrise,sunset"</default>
    </key>
    <key name="day-or-night" type="s">
      <summary>day or night</summary>
      <default>"day"</default>
    </key>
    <key name="last-known-coordinates" type="s">
      <summary>Last known corrdinates</summary>
      <default>""</default>
    </key>
    <key name="timestamp" type="s">
      <description>timestamp of last run</description>
      <default>""</default>
    </key>
    <key name="tzid" type="s">
      <summary>timezone id</summary>
      <default>""</default>
    </key>
  </schema>
</schemalist>
